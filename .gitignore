# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# IBO subject guide PDFs — local only, do not commit (copyright)
docs/*.pdf

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Claude Code local settings
.claude/

# Underscore-prefixed one-off / scratch scripts (diagnostics, patches, harnesses) — local only
scripts/_*

# scripts/screenshot-viewports.ts output — the harness is committed, its PNGs are not.
# They are a per-machine render of the built page (the home machine's shots do not travel),
# regenerable in one command, and heavy. Default --shot target.
shots/

# ClaudeSend*.txt — transient handoff-to-Grant scratch files (overwritten each use), not VCS.
# Widened from the bare `ClaudeSend.txt` on 2026-08-17: a session had written
# ClaudeSend_SBL_VERIFICATION.txt, which the exact-name rule did not match, so a transient
# handoff report was sitting in `git status` as trackable. Anything durable in one of these
# belongs in docs/, not in the handoff file.
ClaudeSend*.txt

# tutor red-team run artifacts (scripts + README committed; transcripts/verdicts are not)
docs/redteam/*
!docs/redteam/README.md

# ACCA official PDFs — re-fetchable evidence, never redistributed in-repo (copyright/brand)
official_acca_pdfs/
# AFM examiner reports — registered in docs/evidence/sources.json (E1–E5), fetch via
# docs/evidence/fetch_acca_sources.ps1. Local working copies must never be committed.
*AFM examiner*.pdf
afm_examiner_report_*.pdf

# SBL working copies — the S26–J27 syllabus & study guide, the seven examiner reports, and the
# cross-paper syllabus-changes deck. All nine are registered in docs/evidence/sources.json
# (SBL-GUIDE, SBL-E1..E7, SBL-CHANGES) with verified URLs and byte sizes, and are fetchable via
# docs/evidence/fetch_acca_sources.ps1. Same fetched-not-stored posture as every other ACCA PDF.
# The repo-side source of record is that manifest; a scripts/sbl-framework.ts does NOT exist yet
# (the AFM/APM analogue of it is the intended home for the 138 LOs, and is unbuilt).
#
# THE WHOLE DIRECTORY, for the docs/FAE/ reason below: `docs/*.pdf` (line 40) does not cross
# a '/', so these files were reported as a trackable untracked directory and one
# `git add .` would have committed them.
docs/sbl/

# Chartered Accountants Ireland competency statements (FAE + CAP2) — registered in
# docs/evidence/sources.json as fetched-not-stored. CAI requires WRITTEN PERMISSION before
# any part is stored in a retrieval system, so these are working copies only: never
# committed, never indexed, never quoted verbatim into a repo document.
#
# THE WHOLE DIRECTORY, NOT A GLOB. `docs/*.pdf` (line 40) matches only the immediate
# children of docs/ — a single `*` never crosses a `/` — so docs/FAE/*.pdf was NOT covered
# by it and the four PDFs were reported by `git status` as a trackable untracked directory.
# One `git add .` would have committed them.
docs/FAE/
