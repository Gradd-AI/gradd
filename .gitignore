# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# IBO subject guide PDFs — local only, do not commit (copyright)
docs/*.pdf

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Claude Code local settings
.claude/

# Underscore-prefixed one-off / scratch scripts (diagnostics, patches, harnesses) — local only
scripts/_*

# scripts/screenshot-viewports.ts output — the harness is committed, its PNGs are not.
# They are a per-machine render of the built page (the home machine's shots do not travel),
# regenerable in one command, and heavy. Default --shot target.
shots/

# ClaudeSend.txt — transient handoff-to-Grant scratch file (overwritten each use), not VCS
ClaudeSend.txt

# tutor red-team run artifacts (scripts + README committed; transcripts/verdicts are not)
docs/redteam/*
!docs/redteam/README.md

# ACCA official PDFs — re-fetchable evidence, never redistributed in-repo (copyright/brand)
official_acca_pdfs/
# AFM examiner reports — registered in docs/evidence/sources.json (E1–E5), fetch via
# docs/evidence/fetch_acca_sources.ps1. Local working copies must never be committed.
*AFM examiner*.pdf
afm_examiner_report_*.pdf
